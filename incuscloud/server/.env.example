# IncusCloud server configuration (all IC_* environment variables).
# Which parts run here: api (HTTP API and gateway), worker (reconciler) or all.
IC_ROLE=all
IC_LISTEN_HOST=0.0.0.0
IC_LISTEN_PORT=8443
# Where users reach IncusCloud; Hydra redirects here (login, consent, device, callback).
IC_PUBLIC_URL=https://cloud.example.com
IC_TLS_CERT=/etc/incuscloud/tls/tls.crt
IC_TLS_KEY=/etc/incuscloud/tls/tls.key
# postgres://… in production; pglite:/path for a single-process development database.
IC_DATABASE_URL=postgres://incuscloud:secret@postgres/incuscloud
# 32+ random bytes, base64: seals cluster client keys and refresh tokens. Keep it; losing it loses enrolled clusters.
IC_SECRET_KEY=
IC_HYDRA_PUBLIC_URL=https://id.example.com
IC_HYDRA_ADMIN_URL=http://hydra-admin:4445
# Only when Hydra uses a private CA.
#IC_HYDRA_CA_FILE=/etc/incuscloud/hydra-ca.crt
IC_OPENFGA_URL=http://openfga:8080
IC_OPENFGA_TOKEN=
IC_OPENFGA_STORE=incuscloud-platform
# OpenFGA as the Incus clusters reach it; defaults to IC_OPENFGA_URL.
#IC_OPENFGA_CLUSTER_URL=http://openfga.cluster-net:8080
# Token the clusters use for OpenFGA; defaults to IC_OPENFGA_TOKEN. See README "Security notes".
#IC_OPENFGA_CLUSTER_TOKEN=
# Seconds between reconciles of each cluster (10..86400); API changes also trigger one.
IC_RECONCILE_INTERVAL=60
# Seconds between inventory and metrics reads of each cluster (0 = off, else 10..86400).
IC_INVENTORY_INTERVAL=60
# Hours of metrics history to keep (1..720).
IC_METRICS_RETENTION=24
# Jobs (migrations, replication runs, failovers) the worker runs at once (1..16).
IC_JOB_CONCURRENCY=2
# Stock Incus clients reach cluster <name> at https://<name>.<IC_CLUSTER_DOMAIN> (wildcard DNS + certificate).
IC_CLUSTER_DOMAIN=clusters.example.com
# First platform admin, created only while no admin exists.
#IC_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
#IC_BOOTSTRAP_ADMIN_PASSWORD=
# Incendio's build (packages/ui/build/ui), served per cluster at /clusters/<name>/ui/.
#IC_UI_DIR=/srv/incendio
# The platform UI build (incuscloud/web/build), served at /.
#IC_WEB_DIR=/srv/incuscloud-web
# Kubernetes (P10): the management cluster's kubeconfig (Cluster API + CAPN installed); unset turns Kubernetes off.
#IC_K8S_KUBECONFIG=/etc/incuscloud/mgmt.kubeconfig
# Ports for Kubernetes API endpoints, forwarded from Incus member addresses.
#IC_K8S_PORTS=16443-16999
# Share of gateway reads (GET/HEAD) recorded in the gateway log, 0..1; changes are always recorded.
IC_GATEWAY_SAMPLE_READS=0
IC_LOG_LEVEL=info
