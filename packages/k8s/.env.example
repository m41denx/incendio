# incendio-k8s agent configuration (copy to .env)
HOST=0.0.0.0
PORT=8443

# Bearer token the Incendio UI must present (>= 16 characters)
AGENT_TOKEN=change-me-to-a-long-random-token

# Secret used to sign JWTs (>= 16 characters)
JWT_SECRET=change-me-to-another-long-random-secret

# Comma-separated allowed browser origins, or * for any
CORS_ORIGIN=https://localhost:8407

# Incus HTTPS API endpoint
INCUS_API_URL=https://127.0.0.1:8443

# Optional client certificate for Incus mTLS
#INCUS_CLIENT_CERT=/path/to/client.crt
#INCUS_CLIENT_KEY=/path/to/client.key
# Incus server certificate to pin (same as lxc-secret server-crt). Preferred
# over INCUS_INSECURE_SKIP_VERIFY; Incus server certs carry the host in their SAN.
#INCUS_SERVER_CERT=/path/to/server.crt
INCUS_INSECURE_SKIP_VERIFY=false

LOG_LEVEL=info
