{
  "name": "@incendio/api",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Incus REST API",
  "license": "LGPL-3.0-only",
  "keywords": [
    "incus",
    "lxc",
    "containers",
    "virtual-machines",
    "kubernetes",
    "sdk",
    "api",
    "incendio"
  ],
  "homepage": "https://github.com/m41denx/incendio/tree/incus-port/packages/api#readme",
  "bugs": {
    "url": "https://github.com/m41denx/incendio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m41denx/incendio.git",
    "directory": "packages/api"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "require": "./dist/api.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./k8s": {
      "types": "./dist/k8s.d.ts",
      "import": "./dist/k8s.js",
      "require": "./dist/k8s.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "generate-types": "bun run scripts/generate-types.ts",
    "lint": "tsc --noEmit",
    "format": "prettier 'src/**/*.ts' 'test/**/*.ts' 'scripts/**/*.ts' --write",
    "test": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "peerDependencies": {
    "node-forge": "^1.3.1",
    "ws": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "node-forge": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node-forge": "1.3.14",
    "@types/ws": "^8.18.1",
    "node-forge": "1.4.0",
    "prettier": "3.7.4",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "ws": "^8.18.3"
  }
}
